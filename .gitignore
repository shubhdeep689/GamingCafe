# ==============================================================================
# IRONCLAD GAMING SANCTUARY — .gitignore
# Professional Git Ignore Rules for Full-Stack PHP/MySQL XAMPP Application
# ==============================================================================

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# --- IDE & Text Editor Files ---
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~
*.bak

# --- Environment & Sensitive Credentials ---
.env
.env.local
.env.*.local
*.env
config.local.php
config/local.php

# --- Server Logs & Diagnostic Outputs ---
*.log
error_log
access_log
logs/
*.sql.gz
*.sql.bak

# --- Temporary Scratch & Testing Directories ---
scratch/
tmp/
temp/
tests/tmp/

# --- Dependency Managers (Future Expansion) ---
/vendor/
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- User Dynamic Media Uploads (Preserve Directories with .gitkeep) ---
uploads/branding/*
!uploads/branding/.gitkeep
uploads/gallery/*
!uploads/gallery/.gitkeep
uploads/qr/*
!uploads/qr/.gitkeep

