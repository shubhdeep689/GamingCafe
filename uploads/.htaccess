# IRONCLAD GAMING SANCTUARY
# Prevent PHP and script execution in uploads

Options -Indexes

<IfModule mod_authz_core.c>
    <FilesMatch "\.(php[0-9]?|phtml|phar|pl|py|cgi|sh|bash|exe)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php[0-9]?|phtml|phar|pl|py|cgi|sh|bash|exe)$">
        Order Allow,Deny
        Deny from all
    </FilesMatch>
</IfModule>
