# ==============================================================================
# IRONCLAD GAMING SANCTUARY — ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and configure your actual environment credentials.
# ==============================================================================

# Application Environment (development / production)
APP_ENV=development
APP_DEBUG=true

# Database Credentials
DB_HOST=127.0.0.1
DB_NAME=ironclad_gaming
DB_USER=root
DB_PASS=
DB_PORT=3306
DB_CHARSET=utf8mb4

# Razorpay Payment Gateway Credentials (Test / Live)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_MODE=test

# Cafe Brand Overrides (Optional)
APP_NAME="IRONCLAD GAMING SANCTUARY"
APP_TAGLINE="Gaming. Competition. Community."

# Developer Emergency Account Recovery Key (Keep Secret)
DEVELOPER_RECOVERY_KEY=change_this_to_a_secure_random_key


